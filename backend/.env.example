DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=boscochat
DB_PASSWORD=replace-with-a-secret-from-the-runtime-secret-store
DB_NAME=boscochat
DB_CONNECTION_LIMIT=10
DB_SSL_MODE=disable
# Optional: base64-encoded RDS CA bundle when the runtime trust store is insufficient.
# DB_SSL_CA_BASE64=

CORS_ORIGINS=http://localhost:5173
# Use none when the Amplify frontend and API are on different sites/domains.
SESSION_COOKIE_SAME_SITE=lax
PORT=3000
TRUST_PROXY=0
NODE_ENV=development

# Required for executing search/chat queries. Values are examples only; set the
# approved per-plan limits and reset periods in deployment configuration.
QUERY_QUOTAS_JSON={"free":{"search":{"limit":50,"periodSeconds":2592000},"chat":{"limit":10,"periodSeconds":2592000}}}
