{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAnnualOriginalsOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::boscochat-archivo-pdfs",
      "Condition": {
        "StringLike": { "s3:prefix": ["originals/", "originals/*"] }
      }
    },
    {
      "Sid": "ReadAndUploadAnnualOriginalsOnly",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::boscochat-archivo-pdfs/originals/*"
    }
  ]
}
